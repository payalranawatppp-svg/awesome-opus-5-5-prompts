{
  "name": "signal-reach-reel",
  "version": "1.0.0",
  "private": true,
  "description": "Signal Reach Instagram Reel — Remotion edit with captions, motion graphics and sound design.",
  "type": "module",
  "scripts": {
    "studio": "remotion studio",
    "render": "remotion render SignalReachReel out/signal-reach-reel.mp4 --codec=h264 --crf=16 --pixel-format=yuv420p --audio-codec=aac --audio-bitrate=256k",
    "qa:layout": "rm -rf out/layout-qa && remotion render LayoutQA out/layout-qa --sequence --image-format=png --scale=0.25 --muted && python3 scripts/check_layout_qa.py out/layout-qa",
    "stills": "node scripts/stills.mjs",
    "typecheck": "tsc --noEmit",
    "render:fx": "remotion render SignalReachReelFx out/signal-reach-reel-fx.mp4 --codec=h264 --crf=16 --pixel-format=yuv420p --audio-codec=aac --audio-bitrate=256k",
    "render:tooth": "remotion render ToothReferralFx out/toothreferral-fx.mp4 --codec=h264 --crf=16 --pixel-format=yuv420p --audio-codec=aac --audio-bitrate=256k",
    "showcase": "remotion render EffectsShowcase out/effects-showcase.mp4 --codec=h264 --crf=16 --pixel-format=yuv420p --audio-codec=aac --audio-bitrate=256k",
    "audio": "python3 scripts/synth_audio.py && ./scripts/process_voice.sh",
    "stems": "for s in voice music sfx; do remotion render SignalReachReel out/stem-$s.wav --codec=wav --props=\"{\\\"stem\\\":\\\"$s\\\"}\"; done"
  },
  "dependencies": {
    "@react-three/fiber": "9.8.2",
    "@remotion/cli": "4.0.535",
    "@remotion/effects": "4.0.535",
    "@remotion/fonts": "4.0.535",
    "@remotion/layout-utils": "4.0.535",
    "@remotion/media": "4.0.535",
    "@remotion/motion-blur": "4.0.535",
    "@remotion/shapes": "4.0.535",
    "@remotion/three": "4.0.535",
    "@remotion/transitions": "4.0.535",
    "@types/three": "0.186.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "remotion": "4.0.535",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@fontsource/caveat": "5.3.0",
    "@fontsource/instrument-serif": "5.3.0",
    "@fontsource/inter": "5.2.8",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/plus-jakarta-sans": "5.2.8",
    "@types/react": "19.1.12",
    "typescript": "5.9.3"
  }
}
