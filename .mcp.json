{
  "mcpServers": {
    "21st": {
      "type": "http",
      "url": "https://21st.dev/api/mcp",
      "headers": {
        "x-api-key": "${API_KEY_21ST:-}"
      }
    },
    "earshot": {
      "command": "python3",
      "args": [
        "-m",
        "earshot",
        "mcp"
      ],
      "env": {
        "EARSHOT_THREADS": "3"
      }
    }
  }
}
